<%inherit file="_templates/site.mako" />

<% 
  gallery = bf.config.controllers.gallery

  categories = []  
  for cat in ('Watercolor', 'Caricature', 'Acrylic'):
    categories.append([c for c in gallery.all_categories if c.name == cat][0])
%>

<div id="category_thumbnails" class="clearfix">
% for cat in categories:
  ${self.cat_image(cat)}
% endfor 
</div>

<%def name="cat_image(category)">
  <div class="category_thumbnail_container thumbnail_container">
  <div class="category_thumbnail thumbnail">
    <div class="image_link_container">
      <a class="image_link" href="${bf.util.path_join(category.path, '#category_name')}">
        <img src="${category.exemplar_picture.image_medium}" alt="Category: ${category.name}"/>
      </a>
    </div>
    <div class="text_link_container">
      <a href="${bf.util.path_join(category.path, '#category_name')}">
        ${category.name}
      </a>
    </div>
  </div>
  </div>
</%def>
